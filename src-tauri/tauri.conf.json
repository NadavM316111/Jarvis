{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "jarvis-web",
  "version": "0.1.0",
  "identifier": "com.heyjarvis.app",
  "build": {
    "frontendDist": "https://heyjarvis.me",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}